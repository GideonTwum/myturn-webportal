# API base URL including /api suffix (same as web NEXT_PUBLIC_API_URL).
# On a physical phone, localhost does NOT reach your PC — use your LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001/api
# In dev, the app auto-uses Metro's host when this is localhost/unset.
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Set to "true" for UI-only mock demo (no backend). Default: connected staging client.
# EXPO_PUBLIC_MOCK_UI=true
