# Public API base URL — the NestJS backend (not the Next.js site), including /api prefix.
# MUST include scheme: https://... (omit it and browsers will hit your Vercel domain instead).
# Local:    http://localhost:3001/api
# Staging:  https://YOUR-SERVICE.up.railway.app/api
# Do NOT use your Vercel frontend URL alone (same-origin would be wrong unless you proxy /api).
NEXT_PUBLIC_API_URL=https://myturn-webportal-staging.up.railway.app/api
NEXT_PUBLIC_DEPLOYMENT_TIER=staging
# For Vercel production builds, set NEXT_PUBLIC_API_URL to EXACTLY e.g.
# https://backend-api-xxxx.up.railway.app/api
