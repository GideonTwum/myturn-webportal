# =============================================================================
# MyTurn — STAGING ecosystem (single source of truth)
# Copy values into each app's git-ignored env file. Never commit secrets.
# =============================================================================

# --- Canonical URLs (all clients MUST match) ---
STAGING_API_URL=https://your-backend.up.railway.app/api
STAGING_WEB_URL=https://your-web.vercel.app
STAGING_DB_HOST=your-railway-postgres-host

# --- Backend (services/backend-api/.env) ---
DEPLOYMENT_TIER=staging
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway?schema=public
JWT_SECRET=use-long-random-string
PORT=3001
CORS_ORIGIN=https://your-web.vercel.app
STAGING_RELAX_TRUST=true
MOCK_PAYMENTS=true
MOCK_PAYOUTS=true
MEMBER_PHONE_LOGIN=true
PUBLIC_API_URL=${STAGING_API_URL}

# --- Web portal (apps/web-portal/.env.local) ---
NEXT_PUBLIC_API_URL=${STAGING_API_URL}
NEXT_PUBLIC_DEPLOYMENT_TIER=staging

# --- Mobile (apps/mobile-app/.env) ---
EXPO_PUBLIC_API_URL=${STAGING_API_URL}
EXPO_PUBLIC_DEPLOYMENT_TIER=staging
# EXPO_PUBLIC_MOCK_UI=false
