# =============================================================================
# MyTurn — STAGING ecosystem (single source of truth)
# Copy values into Railway / Vercel / Expo git-ignored env files. Never commit secrets.
# Full guide: docs/RAILWAY_STAGING_SETUP.md
# =============================================================================

# --- Canonical URLs (all clients MUST match) ---
# Replace YOUR_RAILWAY_HOST with your Railway public domain (no scheme).
STAGING_API_URL=YOUR_RAILWAY_HOST.up.railway.app
STAGING_WEB_URL=https://YOUR_VERCEL_APP.vercel.app

# --- Railway API service variables ---
DEPLOYMENT_TIER=staging
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
JWT_SECRET=<generate-a-long-random-string-min-32-chars>
PORT=3001
CORS_ORIGIN=https://YOUR_VERCEL_APP.vercel.app
STAGING_CORS_EXTRA=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_URL=https://YOUR_RAILWAY_HOST.up.railway.app/api

# Mock money (staging mock UAT — do NOT enable MTN yet)
PAYMENT_PROVIDER=mock
DISBURSEMENT_PROVIDER=mock
MOCK_PAYMENTS=true
MOCK_PAYOUTS=true
STAGING_RELAX_TRUST=true
MEMBER_PHONE_LOGIN=true
CONTRIBUTION_RESERVE_ENABLED=true
ENABLE_RECONCILIATION_JOB=false

# Real SMS (staging UAT uses Arkesel — not console)
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=<set-in-railway-only>
ARKESEL_SENDER_ID=<approved-sender-id>
OTP_DEBUG_IN_RESPONSES=false

# Webhooks (set strong secrets even in staging — MTN uses API verify, not HMAC)
WEBHOOK_SECRET=<generate-strong-secret>
WEBHOOK_SECRET_MTN=<generate-strong-placeholder-before-mtn>

# Optional withdrawal caps (unset = no cap beyond available balance)
# WITHDRAWAL_MAX_SINGLE_AMOUNT=
# CONTRIBUTION_RESERVE_MAX_AMOUNT is deprecated (percentage only)

# --- REMOVE from Railway staging during mock UAT ---
# PAYMENT_PROVIDER=mtn-momo
# DISBURSEMENT_PROVIDER=mtn-momo
# MTN_MOMO_SUBSCRIPTION_KEY=
# MTN_MOMO_API_USER=
# MTN_MOMO_API_KEY=
# MTN_MOMO_CALLBACK_HOST=
# MTN_MOMO_DISBURSEMENT_* (all disbursement MTN vars)

# --- Phase 3: MTN MoMo sandbox (after mock UAT passes — see docs/MTN_WEBHOOK_SECURITY.md) ---
# PAYMENT_PROVIDER=mtn-momo
# DISBURSEMENT_PROVIDER=mtn-momo
# MTN_MOMO_ENVIRONMENT=sandbox
# MTN_MOMO_TARGET_ENV=sandbox
# MTN_MOMO_SUBSCRIPTION_KEY=
# MTN_MOMO_API_USER=
# MTN_MOMO_API_KEY=
# MTN_MOMO_CALLBACK_HOST=https://YOUR_RAILWAY_HOST.up.railway.app
# MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
# MTN_MOMO_DISBURSEMENT_API_USER=
# MTN_MOMO_DISBURSEMENT_API_KEY=
# MTN_MOMO_DISBURSEMENT_CALLBACK_HOST=https://YOUR_RAILWAY_HOST.up.railway.app
# MOCK_PAYMENTS=false  (only after MTN webhooks proven)

# --- Web portal (apps/web-portal/.env.local or Vercel) ---
NEXT_PUBLIC_API_URL=https://YOUR_RAILWAY_HOST.up.railway.app/api
NEXT_PUBLIC_DEPLOYMENT_TIER=staging

# --- Mobile (apps/mobile-app/.env) ---
EXPO_PUBLIC_API_URL=https://YOUR_RAILWAY_HOST.up.railway.app/api
EXPO_PUBLIC_DEPLOYMENT_TIER=staging
EXPO_PUBLIC_MOCK_UI=false
