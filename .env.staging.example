# =============================================================================
# MyTurn — STAGING ecosystem (single source of truth)
# Copy values into Railway / Vercel / Expo git-ignored env files. Never commit secrets.
# Full guide: docs/RAILWAY_STAGING_SETUP.md
# =============================================================================

# --- Canonical URLs (all clients MUST match) ---
STAGING_API_URL=myturn-webportal-staging.up.railway.app
STAGING_WEB_URL=https://myturn-webportal-web-portal.vercel.app/

# --- Railway API service variables ---
DEPLOYMENT_TIER=staging
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=8xFZDaV50XNBEqL7uKN7qoWGxaPfy1oNOWlSStvwT5DcISiN6XU3fvGvS400iTO6
PORT=3001
CORS_ORIGIN=https://myturn-webportal-web-portal.vercel.app
STAGING_CORS_EXTRA=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_URL=https://myturn-webportal-staging.up.railway.app/api

# Staging mock / trust (blocked when DEPLOYMENT_TIER=production)
MOCK_PAYMENTS=true
MOCK_PAYOUTS=true
STAGING_RELAX_TRUST=true
MEMBER_PHONE_LOGIN=true

# OTP / payments (staging defaults — no real providers until keys exist)
SMS_PROVIDER=console
PAYMENT_PROVIDER=mock
ENABLE_RECONCILIATION_JOB=false

# Optional Railway Redis plugin
# REDIS_URL=${{Redis.REDIS_URL}}

# --- Phase 2A: real SMS (see docs/PHASE_2_RUNBOOK.md) ---
# SMS_PROVIDER=arkesel
# ARKESEL_API_KEY=
# ARKESEL_SENDER_ID=MyTurn

# --- Phase 2B: MTN MoMo sandbox (hybrid: keep MOCK_PAYMENTS=true until webhooks complete) ---
# PAYMENT_PROVIDER=mtn-momo
# MTN_MOMO_ENVIRONMENT=sandbox
# MTN_MOMO_TARGET_ENV=sandbox
# MTN_MOMO_SUBSCRIPTION_KEY=
# MTN_MOMO_API_USER=
# MTN_MOMO_API_KEY=
# MTN_MOMO_CALLBACK_HOST=https://your-backend.up.railway.app
# WEBHOOK_SECRET_MTN=

# --- Web portal (apps/web-portal/.env.local) ---
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app/api
NEXT_PUBLIC_DEPLOYMENT_TIER=staging

# --- Mobile (apps/mobile-app/.env) ---
EXPO_PUBLIC_API_URL=https://your-backend.up.railway.app/api
EXPO_PUBLIC_DEPLOYMENT_TIER=staging
# EXPO_PUBLIC_MOCK_UI=false
