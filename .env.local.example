# =============================================================================
# MyTurn — LOCAL connected staging (Docker Postgres on 5433)
# =============================================================================

STAGING_API_URL=http://localhost:3001/api
STAGING_WEB_URL=http://localhost:3000
# STAGING_DB: postgresql://postgres:postgres@127.0.0.1:5433/myturn

# --- Backend → services/backend-api/.env ---
DEPLOYMENT_TIER=local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/myturn?schema=public
JWT_SECRET=local-dev-jwt-secret-change-in-production
PORT=3001
STAGING_RELAX_TRUST=true
MOCK_PAYMENTS=true
MOCK_PAYOUTS=true
MEMBER_PHONE_LOGIN=true
PUBLIC_API_URL=http://localhost:3001/api

# Contribution Guarantee Reserve (percentage only — no GHS cap)
CONTRIBUTION_RESERVE_ENABLED=true
CONTRIBUTION_RESERVE_MAX_BPS=3000
CONTRIBUTION_RESERVE_MIN_BPS=0
# Do not set CONTRIBUTION_RESERVE_MAX_AMOUNT (deprecated)

# Withdrawal limits — unset = withdraw up to available balance
# WITHDRAWAL_MAX_SINGLE_AMOUNT=
# WITHDRAWAL_MAX_DAILY_AMOUNT=
# WITHDRAWAL_MAX_DAILY_COUNT=

# --- Web → apps/web-portal/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_DEPLOYMENT_TIER=local

# --- Mobile → apps/mobile-app/.env ---
EXPO_PUBLIC_API_URL=http://localhost:3001/api
EXPO_PUBLIC_DEPLOYMENT_TIER=local
EXPO_PUBLIC_MOCK_UI=false
