generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum AdminRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutMode {
  DAILY
  CYCLE
}

enum ContributionFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum GroupScheduleUnit {
  DAY
  WEEK
  MONTH
}

enum GroupStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum GroupMemberStatus {
  ACTIVE
  LEFT
}

/** Cycle payout discipline (CYCLE groups only). */
enum MemberCycleStanding {
  ACTIVE
  LATE
  DEFAULTED
}

/** Security deposit held in the member's wallet (locked balance). */
enum DepositStatus {
  NOT_REQUIRED
  HELD
  FORFEITED
  RELEASED
}

enum ContributionStatus {
  PENDING
  PAID
  LATE
  WAIVED
}

enum PaymentType {
  CONTRIBUTION
  PAYOUT
  ADJUSTMENT
  FEE
  DEPOSIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  /** Legacy / external disbursement complete */
  COMPLETED
  /** Net payout credited to member wallet (MyTurn holds funds) */
  CREDITED
  FAILED
}

enum LedgerAccountType {
  SYSTEM_EXTERNAL
  PLATFORM_FLOAT
  GROUP_POOL
  MEMBER_WALLET
  ADMIN_EARNINGS
  MYTURN_REVENUE
  WITHDRAWAL_CLEARING
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum WithdrawalActorRole {
  MEMBER
  ADMIN
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

/** Member trust tier — phone OTP vs Ghana Card verified. */
enum MemberAuthorizationLevel {
  PHONE_VERIFIED
  VERIFIED_MEMBER
}

enum GhanaCardVerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentRequestStatus {
  PENDING
  APPROVED
  FAILED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  /** Set when the user is marked DEFAULTED on a CYCLE group (trust / ops flag). */
  cycleDefaultFlagged Boolean @default(false)
  memberAuthorizationLevel MemberAuthorizationLevel @default(PHONE_VERIFIED)
  ghanaCardVerificationStatus GhanaCardVerificationStatus @default(NOT_SUBMITTED)
  /** SHA-256 of normalized Ghana Card number — never expose in APIs. */
  ghanaCardNumberHash String? @unique
  ghanaCardLast4      String?
  verificationSubmittedAt DateTime?
  verificationApprovedAt  DateTime?
  verificationRejectedAt  DateTime?
  verificationRejectionReason String?
  selfieAssetKey      String?
  cardImageAssetKey   String?
  completedGroupsCount Int @default(0)
  missedContributionCount Int @default(0)
  contributionStreak  Int @default(0)
  trustScore          Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallet            Wallet?
  paymentRequests   PaymentRequest[]
  groupMemberships  GroupMember[]
  groupsAdmin       Group[]           @relation("GroupAdmin")
  contributions     Contribution[]
  payoutsReceived   Payout[]          @relation("PayoutRecipient")
  payments          Payment[]
  adminRequests     AdminRequest[]    @relation("AdminRequestApplicant")
  reviewedRequests  AdminRequest[]    @relation("AdminRequestReviewer")
  adminEarnings     AdminEarning[]
  notifications     Notification[]
  deviceTokens      DeviceToken[]
  auditLogs         AuditLog[]        @relation("AuditActor")
}

model AdminRequest {
  id           String               @id @default(cuid())
  applicantId  String
  applicant    User                 @relation("AdminRequestApplicant", fields: [applicantId], references: [id])
  status       AdminRequestStatus   @default(PENDING)
  message      String?
  reviewedById String?
  reviewedBy   User?                @relation("AdminRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model Group {
  id                 String                 @id @default(cuid())
  name               String
  description        String?
  /** Invite-only join (e.g. MT-A3K7). Unique; inactive once group is no longer DRAFT for join purposes. */
  inviteCode         String                 @unique
  adminId            String
  admin              User                   @relation("GroupAdmin", fields: [adminId], references: [id])
  contributionAmount Decimal                @db.Decimal(18, 2)
  /** Per-member payment count per cycle (CYCLE mode: daily × this = obligation; DAILY mode: stored as 1). */
  daysPerCycle       Int                    @default(1)
  payoutMode         PayoutMode             @default(CYCLE)
  frequency          ContributionFrequency
  memberSlots        Int
  serviceMarginBps   Int                    @default(1000)
  scheduleFrequencyValue Int               @default(1)
  scheduleFrequencyUnit  GroupScheduleUnit @default(MONTH)
  groupStartDate     DateTime?
  groupEndDate       DateTime?
  currentCycle       Int                    @default(1)
  status             GroupStatus            @default(DRAFT)
  /** Extra calendar days after the theoretical cycle end before auto-DEFAULTED (CYCLE mode). */
  defaultGraceDays   Int                    @default(2)
  /** When true, admins may finalize a payout despite DEFAULTED members (staging / ops). */
  allowPayoutOverride Boolean               @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  members         GroupMember[]
  contributions   Contribution[]
  payouts         Payout[]
  payments        Payment[]
  paymentRequests PaymentRequest[]
  adminEarnings   AdminEarning[]
}

model GroupMember {
  id         String            @id @default(cuid())
  groupId    String
  group      Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  turnOrder  Int
  status     GroupMemberStatus @default(ACTIVE)
  /** CYCLE groups: payment discipline for the current period (see cycle compliance job). */
  cycleStanding   MemberCycleStanding @default(ACTIVE)
  /** CYCLE: contributionAmount × daysPerCycle held in wallet.lockedBalance while HELD. */
  depositAmount   Decimal             @default(0) @db.Decimal(18, 2)
  depositStatus   DepositStatus       @default(NOT_REQUIRED)
  joinedAt   DateTime          @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
}

model Contribution {
  id          String             @id @default(cuid())
  groupId     String
  group       Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  cycleNumber       Int
  amount            Decimal            @db.Decimal(18, 2)
  expectedDayCount  Int                @default(1)
  paidDayCount      Int                @default(0)
  dueDate           DateTime?
  status            ContributionStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  payments        Payment[]
  paymentRequests PaymentRequest[]

  @@index([groupId, cycleNumber])
  @@index([userId])
}

model Payment {
  id              String        @id @default(cuid())
  externalRef     String?       @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  groupId         String?
  group           Group?        @relation(fields: [groupId], references: [id])
  contributionId  String?
  contribution    Contribution? @relation(fields: [contributionId], references: [id])
  amount          Decimal       @db.Decimal(18, 2)
  type            PaymentType
  status          PaymentStatus @default(PENDING)
  metadata        Json?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())

  @@index([groupId])
  @@index([userId])
}

model Payout {
  id          String       @id @default(cuid())
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User         @relation("PayoutRecipient", fields: [recipientId], references: [id])
  cycleNumber Int
  amount      Decimal      @db.Decimal(18, 2)
  status      PayoutStatus @default(PENDING)
  paidAt      DateTime?
  creditedAt  DateTime?
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([groupId, cycleNumber])
  @@index([groupId, cycleNumber])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  /** Escrow for CYCLE group security deposits (not spendable until released). */
  lockedBalance Decimal @default(0) @db.Decimal(18, 2)
  currency  String   @default("GHS")
  updatedAt DateTime @updatedAt
}

/** Canonical ledger account — source of truth for wallet-based balances. */
model LedgerAccount {
  id          String            @id @default(cuid())
  accountKey  String            @unique
  accountType LedgerAccountType
  userId      String?
  groupId     String?
  currency    String            @default("GHS")
  balance     Decimal           @default(0) @db.Decimal(18, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  lines LedgerLine[]

  @@index([accountType])
  @@index([userId])
  @@index([groupId])
}

/** Balanced financial journal (sum of line deltas must be zero). */
model LedgerTransaction {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  referenceType  String
  referenceId    String
  description    String?
  metadata       Json?
  createdAt      DateTime @default(now())

  lines LedgerLine[]

  @@index([referenceType, referenceId])
}

model LedgerLine {
  id            String          @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId     String
  account       LedgerAccount   @relation(fields: [accountId], references: [id])
  /** Signed delta applied to account balance (must sum to 0 per transaction). */
  delta         Decimal         @db.Decimal(18, 2)
  balanceAfter  Decimal         @db.Decimal(18, 2)
  createdAt     DateTime        @default(now())

  @@index([accountId])
  @@index([transactionId])
}

model WithdrawalRequest {
  id            String              @id @default(cuid())
  actorId       String
  actorRole     WithdrawalActorRole
  ledgerAccountId String
  amount        Decimal             @db.Decimal(18, 2)
  status        WithdrawalStatus    @default(PENDING)
  momoNumber    String
  provider      String?
  providerRef   String?
  requestedAt   DateTime            @default(now())
  processedAt   DateTime?
  confirmedById String?
  failureReason String?
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([actorId, status])
  @@index([status])
}

model LedgerEntry {
  id             String          @id @default(cuid())
  type           LedgerEntryType
  amount         Decimal         @db.Decimal(18, 2)
  userId         String?
  groupId        String?
  referenceType  String
  referenceId    String
  description    String?
  metadata       Json?
  balanceAfter   Decimal?        @db.Decimal(18, 2)
  createdAt      DateTime        @default(now())

  @@index([userId])
  @@index([groupId])
  @@index([referenceType, referenceId])
}

model AdminEarning {
  id                 String    @id @default(cuid())
  adminId            String
  admin              User      @relation(fields: [adminId], references: [id])
  groupId            String?
  group              Group?    @relation(fields: [groupId], references: [id])
  cycleNumber        Int?
  marginAmount       Decimal   @db.Decimal(18, 2)
  adminShareAmount   Decimal   @db.Decimal(18, 2)
  platformShareAmount Decimal  @db.Decimal(18, 2)
  settledAt          DateTime?
  createdAt          DateTime  @default(now())

  @@index([adminId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, read])
}

/** Expo push token registration — delivery provider wired in a later phase. */
model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String
  platform   DevicePlatform
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, token])
  @@index([userId])
}

/** MoMo / mobile-money contribution request lifecycle (provider integration later). */
model PaymentRequest {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId         String
  group           Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contributionId  String
  contribution    Contribution         @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  amount          Decimal              @db.Decimal(18, 2)
  status          PaymentRequestStatus @default(PENDING)
  externalRef     String               @unique @default(cuid())
  providerRef     String?
  expiresAt       DateTime
  approvedAt      DateTime?
  failureReason   String?
  metadata        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId, status])
  @@index([contributionId])
}

model ReconciliationSnapshot {
  id               String   @id @default(cuid())
  status           String
  discrepancyCount Int      @default(0)
  summary          Json
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}
