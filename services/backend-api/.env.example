# Copy to `.env` for local development (never commit `.env`).

# -----------------------------------------------------------------------------
# DATABASE_URL
# -----------------------------------------------------------------------------
# Format (placeholders only — use your real credentials locally, never in git):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
#
# --- Local Docker (see repo root `docker-compose.yml`) ---
# Compose maps Postgres to host port 5433 (avoids conflict with a local Postgres on 5432).
# Example:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/myturn?schema=public"
#
# --- Railway backend runtime (inside Railway only) ---
# Use the **private/internal** URL (`postgres.railway.internal`). In Railway → your
# **API** service → Variables, set `DATABASE_URL` to the variable reference:
#   ${{ Postgres.DATABASE_URL }}
# (Replace `Postgres` with your Postgres plugin service name if different.)
# Resolves to something like:
# postgresql://...@postgres.railway.internal:5432/railway
#
# --- Local Prisma CLI from your laptop (migrations against Railway Postgres) ---
# `postgres.railway.internal` does **not** resolve outside Railway. Use Railway’s
# **public** connection URL (Dashboard → Postgres → Connect → **Public Network**):
# postgresql://...@<public-host>:<public-port>/railway
# Copy only into a **local, git-ignored** file (e.g. `.env.railway-public`) or export
# `DATABASE_URL` for that shell session. See `.env.railway-public.example` and README.
# -----------------------------------------------------------------------------

# DATABASE_URL=

# Required in production (NODE_ENV=production). Use a long random string.
JWT_SECRET="change-me-in-production-use-long-random-string"

# API listen port (staging platforms often set PORT via the host)
PORT=3001

# Optional: comma-separated allowed web origins for CORS (e.g. https://app.example.com,https://www.example.com)
# Railway staging: set to your Vercel URL. Optional localhost via STAGING_CORS_EXTRA.
# CORS_ORIGIN=https://your-web-app.vercel.app
# STAGING_CORS_EXTRA=http://localhost:3000,http://127.0.0.1:3000

# Deployment tier: local | staging | production (controls mock/trust flags)
DEPLOYMENT_TIER=local

# Public URL clients should use (shown in health + invite errors)
# Railway staging: https://YOUR_APP.up.railway.app/api
PUBLIC_API_URL=http://localhost:3001/api

# Optional: set to "production" in staging/production
# NODE_ENV=production

# Staging-only (blocked in production by startup safety check)
# MOCK_PAYMENTS=true
# MOCK_PAYOUTS=true
# MEMBER_PHONE_LOGIN=true

# OTP / Redis (optional locally; recommended in CI/staging)
# REDIS_URL=redis://127.0.0.1:6379
# SMS_PROVIDER=console|arkesel
# With arkesel, on-screen OTP is off unless OTP_DEBUG_IN_RESPONSES=true
# OTP_DEBUG_IN_RESPONSES=false
# OTP_TTL_MS=300000
# OTP_RESEND_COOLDOWN_SEC=60
# OTP_REQUEST_LIMIT=5
# OTP_REQUEST_WINDOW_SEC=900

# Arkesel SMS (staging/production OTP delivery)
# ARKESEL_API_KEY=Zmx3alJua0pQSGdJSE1QbWhVZUU
# ARKESEL_SENDER_ID=MyTurn
# ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2/sms/send
# ARKESEL_TIMEOUT_MS=12000

# Payments
# PAYMENT_PROVIDER=mock|mtn|mtn-momo
# MTN_MOMO_API_KEY=
# MTN_MOMO_API_USER=
# MTN_MOMO_API_SECRET=
# MTN_MOMO_SUBSCRIPTION_KEY=
# MTN_MOMO_ENVIRONMENT=sandbox
# MTN_MOMO_TARGET_ENV=sandbox
# MTN_MOMO_CALLBACK_HOST=https://your-api.example.com

# Withdrawal safety limits (member + admin)
# WITHDRAWAL_MIN_AMOUNT=1
# WITHDRAWAL_MAX_SINGLE_AMOUNT=5000
# WITHDRAWAL_MAX_DAILY_AMOUNT=10000
# WITHDRAWAL_MAX_DAILY_COUNT=5
# STALE_WITHDRAWAL_THRESHOLD_MS=1800000

# Member wallet disbursement (separate from Collection / PAYMENT_PROVIDER)
# DISBURSEMENT_PROVIDER=mock|mtn-momo
# MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
# MTN_MOMO_DISBURSEMENT_API_USER=
# MTN_MOMO_DISBURSEMENT_API_KEY=
# MTN_MOMO_DISBURSEMENT_ENVIRONMENT=sandbox
# MTN_MOMO_DISBURSEMENT_TARGET_ENV=sandbox
# MTN_MOMO_DISBURSEMENT_CALLBACK_HOST=https://your-api.example.com
# Note: MTN Collection credentials (MTN_MOMO_SUBSCRIPTION_KEY etc.) are a different product.

# Webhooks + reconciliation
# WEBHOOK_SECRET=
# WEBHOOK_SECRET_MTN=
# ENABLE_RECONCILIATION_JOB=true

# Railway staging: see docs/RAILWAY_STAGING_SETUP.md and .env.staging.example
# Runtime DATABASE_URL on Railway: ${{ Postgres.DATABASE_URL }} (private)
# Laptop migrations: services/backend-api/.env.railway-public (public URL only)

# Testing: auto-approve Ghana Card, allow join/contribute without HQ review.
# Defaults on when NODE_ENV is not production. Set false to enforce gates locally.
# STAGING_RELAX_TRUST=true
