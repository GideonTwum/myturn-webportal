# Copy to `.env` for local development (never commit `.env`).

# -----------------------------------------------------------------------------
# DATABASE_URL
# -----------------------------------------------------------------------------
# Format (placeholders only — use your real credentials locally, never in git):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
#
# --- Local Docker (see repo root `docker-compose.yml`) ---
# Compose maps Postgres to host port 5433 (avoids conflict with a local Postgres on 5432).
# Example:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/myturn?schema=public"
#
# --- Railway backend runtime (inside Railway only) ---
# Use the **private/internal** URL (`postgres.railway.internal`). In Railway → your
# **API** service → Variables, set `DATABASE_URL` to the variable reference:
#   ${{ Postgres.DATABASE_URL }}
# (Replace `Postgres` with your Postgres plugin service name if different.)
# Resolves to something like:
# postgresql://...@postgres.railway.internal:5432/railway
#
# --- Local Prisma CLI from your laptop (migrations against Railway Postgres) ---
# `postgres.railway.internal` does **not** resolve outside Railway. Use Railway’s
# **public** connection URL (Dashboard → Postgres → Connect → **Public Network**):
# postgresql://...@<public-host>:<public-port>/railway
# Copy only into a **local, git-ignored** file (e.g. `.env.railway-public`) or export
# `DATABASE_URL` for that shell session. See `.env.railway-public.example` and README.
# -----------------------------------------------------------------------------

# DATABASE_URL=

# Required in production (NODE_ENV=production). Use a long random string.
JWT_SECRET="change-me-in-production-use-long-random-string"

# API listen port (staging platforms often set PORT via the host)
PORT=3001

# Optional: comma-separated allowed web origins for CORS (e.g. https://app.example.com,https://www.example.com)
# If unset, all origins are allowed (development-friendly; set in staging/production).
# CORS_ORIGIN=https://your-web-app.vercel.app

# Optional: set to "production" in staging/production
# NODE_ENV=production

# Testing: auto-approve Ghana Card, allow join/contribute without HQ review.
# Defaults on when NODE_ENV is not production. Set false to enforce gates locally.
# STAGING_RELAX_TRUST=true
